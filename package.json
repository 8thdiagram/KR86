    "fake-indexeddb": "^6.2.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "~5.9.3",
    "vite": "7.3.7",
    "wouter": "^3.3.5"
  },
  "packageManager": "pnpm@10.26.1"
